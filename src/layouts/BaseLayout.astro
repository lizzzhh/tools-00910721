---
import Header from '../components/Header.astro'
import Sidebar from '../components/Sidebar.astro'
import Footer from '../components/Footer.astro'
import Scratchpad from '../components/Scratchpad.astro'
import { Icon } from 'astro-icon/components'
import { ClientRouter } from 'astro:transitions'
import { defaultLocale, localeMeta, localePath, locales } from '../i18n/config'
import { createTranslator } from '../i18n'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  activeTool?: string
  activeNav?: 'home' | 'tools' | 'favorites' | 'data' | 'about'
}

const { title, description, activeTool = '', activeNav = 'tools' } = Astro.props
const locale = Astro.locals.locale
const t = createTranslator(locale)
const siteName = t('meta.siteName')

/**
 * Canonical plus one hreflang alternate per locale, each pointing at the same
 * page in that language. Search engines need the reciprocal links to treat the
 * variants as translations of one document rather than duplicates.
 */
/**
 * Zen mode is chosen by the query string, but every page here is prerendered, so
 * `Astro.url` cannot see it at runtime. The pathname is still known at build
 * time, which is what the exit link needs: the same page without the parameter.
 */
const exitHref = Astro.url.pathname
const canonicalPath = Astro.url.pathname
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url.origin).href
const alternates = locales.map((candidate) => ({
  locale: candidate,
  hreflang: localeMeta[candidate].htmlLang,
  href: new URL(localePath(candidate, canonicalPath), Astro.site ?? Astro.url.origin).href
}))
// The default locale is the one served without a path prefix, so it is the only
// page where the browser's language preference may override what is on screen.
const isDefaultLocale = locale === defaultLocale
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang} dir="ltr" data-locale={locale} class="enable-card-border">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2f7f7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates.find((item) => item.locale === 'zh-CN')?.href ?? canonical} />
    <title>{title}</title>
    <script is:inline>
      // The theme and the language are read from a cookie rather than from
      // IndexedDB: an async store cannot answer before the first paint, and a
      // wrong guess here is a visible flash. The cookie is a mirror, never the
      // source of truth — the storage table rewrites it on boot. Defined once
      // and read by both scripts that follow.
      window.readMirror = function (key) {
        var name = 'cs-' + key + '='
        var parts = document.cookie ? document.cookie.split(';') : []
        for (var i = 0; i < parts.length; i += 1) {
          var part = parts[i].trim()
          if (part.indexOf(name) === 0) {
            try {
              return decodeURIComponent(part.slice(name.length))
            } catch (e) {
              return part.slice(name.length)
            }
          }
        }
        return null
      }
    </script>
    <script is:inline define:vars={{ locale, alternates, isDefaultLocale }}>
      // Runs before paint so a first-time visitor with a non-Chinese browser
      // language never sees a flash of the wrong language. An explicit choice in
      // the switcher always wins and is never overridden.
      ;(function () {
        try {
          // `alternates[].href` is absolute and points at the configured site,
          // which is not where a dev or preview server runs. Taking only the path
          // keeps the language switch on the current origin, so visiting /ja
          // locally serves the Japanese homepage instead of bouncing to the
          // production host.
          var localHref = function (href) {
            try {
              var url = new URL(href)
              return url.origin === location.origin ? url.href : location.origin + url.pathname + url.search
            } catch (e) {
              return null
            }
          }
          var stored = readMirror('code-space-locale')
          if (stored) {
            if (stored !== locale) {
              var target = alternates.filter(function (a) { return a.locale === stored })[0]
              if (target) {
                var href = localHref(target.href)
                if (href) location.replace(href)
              }
            }
            return
          }
          // A locale prefix in the URL is itself an explicit choice, so browser
          // preference only gets a say on the unprefixed default.
          if (isDefaultLocale && document.documentElement.lang) {
            var preferred = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language]) || []
            var best = null
            for (var i = 0; i < preferred.length; i += 1) {
              var tag = String(preferred[i] || '').toLowerCase()
              if (!tag) continue
              if (tag.indexOf('zh') === 0) {
                best = /hant|tw|hk|mo/.test(tag) ? 'zh-TW' : 'zh-CN'
              } else if (tag.indexOf('en') === 0) best = 'en'
              else if (tag.indexOf('ja') === 0) best = 'ja'
              if (best) break
            }
            if (best && best !== locale) {
              var match = alternates.filter(function (a) { return a.locale === best })[0]
              if (match) {
                var next = localHref(match.href)
                if (next) location.replace(next)
              }
            }
          }
        } catch (e) {}
      })()
    </script>
    <script is:inline data-astro-rerun>
      // Applied before the first paint so a Zen page never flashes the toolbox
      // on its way to hiding it. `data-astro-rerun` is required because the
      // client router swaps pages without re-running inline scripts, which
      // would leave both entering and leaving Zen mode broken. Toggling rather
      // than adding is what makes the exit link work: it navigates with the
      // parameter removed, and that navigation is a swap too.
      try {
        var zen = new URLSearchParams(location.search).has('zen')
        document.documentElement.classList.toggle('zen-mode', zen)
      } catch (e) {}
    </script>
    <script is:inline>
      // The theme and the language are read from a cookie rather than from
      // IndexedDB: an async store cannot answer before the first paint, and a
      // wrong guess here is a visible flash. The cookie is a mirror, never the
      // source of truth — the storage table rewrites it on boot.
      try {
        const saved = readMirror('code-space-theme')
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.classList.toggle('dark', dark)
      } catch {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <div class="zen-bar" id="zen-bar">
      <a class="zen-exit" id="zen-exit" href={exitHref} title={t('zen.exitLabel')}>
        <span class="brand-mark"><Icon name="lucide:command" size={15} /></span>
        <span class="zen-exit-name">{siteName}</span>
      </a>
      <span class="zen-badge"><Icon name="lucide:coffee" size={13} />{t('zen.badge')}</span>
      <details class="info-dot">
        <summary title={t('zen.infoLabel')} aria-label={t('zen.infoLabel')}><Icon name="lucide:info" size={14} /></summary>
        <div class="info-note">
          <strong>{t('zen.title')}</strong>
          <p>{t('zen.summary')}</p>
          <ul>
            <li>{t('zen.pointEnable')}</li>
            <li>{t('zen.pointHide')}</li>
            <li>{t('zen.pointExit')}</li>
          </ul>
        </div>
      </details>
    </div>
    <Header activeNav={activeNav} />
    <div class="mobile-backdrop" id="mobile-backdrop"></div>
    <div class="app-shell">
      <Sidebar activeTool={activeTool} activeNav={activeNav} />
      <main class="main-content">
        <slot />
        <Footer />
      </main>
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite">
      <span class="toast-icon"><svg aria-hidden="true"><use href="#icon-check"></use></svg></span>
      <span id="toast-text"></span>
    </div>
    <svg class="svg-sprite" aria-hidden="true">
      <symbol id="icon-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></symbol>
      <symbol id="icon-hash" viewBox="0 0 24 24"><path d="M10 3 8 21M16 3l-2 18M4 9h16M3 15h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></symbol>
      <symbol id="icon-trash-2" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></symbol>
    </svg>
    <Scratchpad />
    <script>
      import '../scripts/site'
    </script>
  </body>
</html>
