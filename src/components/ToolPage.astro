---
import { Icon } from 'astro-icon/components'
import BaseLayout from '../layouts/BaseLayout.astro'
import JwtDecodeTool from '../components/tools/JwtDecodeTool.astro'
import PasswordGeneratorTool from '../components/tools/PasswordGeneratorTool.astro'
import PasswordStrengthTool from '../components/tools/PasswordStrengthTool.astro'
import HashTool from '../components/tools/HashTool.astro'
import JsonFormatTool from '../components/tools/JsonFormatTool.astro'
import Base64Tool from '../components/tools/Base64Tool.astro'
import UrlEncodeTool from '../components/tools/UrlEncodeTool.astro'
import HtmlEntityTool from '../components/tools/HtmlEntityTool.astro'
import UnicodeEscapeTool from '../components/tools/UnicodeEscapeTool.astro'
import QueryStringTool from '../components/tools/QueryStringTool.astro'
import NumberBaseTool from '../components/tools/NumberBaseTool.astro'
import UuidGeneratorTool from '../components/tools/UuidGeneratorTool.astro'
import UuidParserTool from '../components/tools/UuidParserTool.astro'
import TimestampTool from '../components/tools/TimestampTool.astro'
import TextCaseTool from '../components/tools/TextCaseTool.astro'
import TextCounterTool from '../components/tools/TextCounterTool.astro'
import TextDedupeTool from '../components/tools/TextDedupeTool.astro'
import TextReplaceTool from '../components/tools/TextReplaceTool.astro'
import FullwidthHalfwidthTool from '../components/tools/FullwidthHalfwidthTool.astro'
import Bip39Tool from '../components/tools/Bip39Tool.astro'
import TronLotteryTool from '../components/tools/TronLotteryTool.astro'
import MarketTool from '../components/tools/MarketTool.astro'
import type { LocalizedTool } from '../data/tools'
import { createTranslator } from '../i18n'
import { localePath } from '../i18n/config'

interface Props {
  tool: LocalizedTool
}

const { tool } = Astro.props
const locale = Astro.locals.locale
const t = createTranslator(locale)
const siteName = t('meta.siteName')
const toolsHref = localePath(locale, '/tools/')
---

<BaseLayout title={`${tool.name} · ${siteName}`} description={tool.description} activeTool={tool.id} activeNav="tools">
  {tool.id === 'hash' ? <HashTool /> : tool.id === 'jwt-decode' ? <JwtDecodeTool /> : tool.id === 'password-generator' ? <PasswordGeneratorTool /> : tool.id === 'password-strength' ? <PasswordStrengthTool /> : tool.id === 'json-format' ? <JsonFormatTool /> : tool.id === 'base64' ? <Base64Tool /> : tool.id === 'url-encode' ? <UrlEncodeTool /> : tool.id === 'html-entity' ? <HtmlEntityTool /> : tool.id === 'unicode-escape' ? <UnicodeEscapeTool /> : tool.id === 'query-string' ? <QueryStringTool /> : tool.id === 'number-base' ? <NumberBaseTool /> : tool.id === 'uuid-generator' ? <UuidGeneratorTool /> : tool.id === 'uuid-parser' ? <UuidParserTool /> : tool.id === 'timestamp-converter' ? <TimestampTool /> : tool.id === 'text-case' ? <TextCaseTool /> : tool.id === 'text-counter' ? <TextCounterTool /> : tool.id === 'text-deduplicate' ? <TextDedupeTool /> : tool.id === 'text-replace' ? <TextReplaceTool /> : tool.id === 'fullwidth-halfwidth' ? <FullwidthHalfwidthTool /> : tool.id === 'bip39' ? <Bip39Tool /> : tool.id === 'tron-lottery' ? <TronLotteryTool /> : tool.id === 'market' ? <MarketTool locale={locale} /> : (
    <section class="simple-page card-base">
      <span class="eyebrow">COMING SOON</span>
      <div class="simple-page-icon"><Icon name={tool.icon} size={30} /></div>
      <h1>{tool.name}</h1>
      <p>{t('toolsPage.comingSoonBody')}</p>
      <a class="primary-button" href={toolsHref}>{t('toolsPage.browseCatalog')}<Icon name="lucide:arrow-right" size={18} /></a>
    </section>
  )}
</BaseLayout>
