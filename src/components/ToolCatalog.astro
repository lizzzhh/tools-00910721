---
import { Icon } from 'astro-icon/components'
import { categoryName, localizeTools, plannedTools, toolCategories, tools } from '../data/tools'
import { createTranslator } from '../i18n'
import ToolCard from './ToolCard.astro'

interface Props {
  favoritesOnly?: boolean
}

const { favoritesOnly = false } = Astro.props
const t = createTranslator(Astro.locals.locale)
const categories = toolCategories.map((category) => ({ ...category, name: categoryName(category.id, t) }))
const allTools = localizeTools([...tools, ...plannedTools], t)
---

<section class="tool-catalog" data-catalog data-favorites-only={favoritesOnly ? 'true' : 'false'}>
  <div class="catalog-heading">
    <div>
      <span class="eyebrow">{t('catalog.eyebrow')}</span>
      <h1>{favoritesOnly ? t('catalog.favoritesTitle') : t('catalog.title')}</h1>
      <p>{favoritesOnly ? t('catalog.favoritesSubtitle') : t('catalog.subtitle')}</p>
    </div>
    <span class="catalog-count" id="catalog-count">{t('catalog.count', { available: tools.length, planned: plannedTools.length })}</span>
  </div>

  <div class="catalog-toolbar">
    <label class="catalog-search">
      <Icon name="lucide:search" size={17} />
      <input id="catalog-search-input" type="search" placeholder={t('catalog.searchPlaceholder')} autocomplete="off" />
    </label>
    <div class="catalog-filters" role="group" aria-label={t('catalog.filterLabel')}>
      <button class="catalog-filter active" type="button" data-category="all">{t('catalog.all')}</button>
      {categories.map((category) => <button class="catalog-filter" type="button" data-category={category.id}>{category.name}</button>)}
    </div>
  </div>

  <div class="catalog-grid">
    {allTools.map((tool) => <ToolCard tool={tool} />)}
  </div>
  <div class="catalog-empty" id="catalog-empty" hidden>
    <Icon name={favoritesOnly ? 'lucide:star' : 'lucide:search-x'} size={22} />
    <strong>{favoritesOnly ? t('catalog.favoritesEmptyTitle') : t('catalog.emptyTitle')}</strong>
    <span>{favoritesOnly ? t('catalog.favoritesEmptyHint') : t('catalog.emptyHint')}</span>
  </div>
</section>

<script>
  import '../scripts/catalog'
</script>
