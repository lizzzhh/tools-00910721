---
import { Icon } from 'astro-icon/components'

type Option = {
  value: string
  label: string
}

interface Props {
  id: string
  label: string
  options: Option[]
  value?: string
  name?: string
  disabled?: boolean
}

const { id, label, options, value = options[0]?.value ?? '', name, disabled = false } = Astro.props
const selectedOption = options.find((option) => option.value === value) ?? options[0]
---

<div class="ui-select-field" data-select>
  <label for={`${id}-trigger`}>{label}</label>
  <span class="ui-select-wrap">
    <input id={id} name={name} type="hidden" value={selectedOption?.value ?? ''} disabled={disabled} />
    <button class="ui-select-trigger" id={`${id}-trigger`} type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls={`${id}-menu`} disabled={disabled}>
      <span>{selectedOption?.label ?? ''}</span>
      <Icon name="lucide:chevron-down" size={15} />
    </button>
    <div class="ui-select-menu" id={`${id}-menu`} role="listbox" aria-label={label} hidden>
      {options.map((option) => (
        <button class:list={{ selected: option.value === selectedOption?.value }} type="button" role="option" aria-selected={option.value === selectedOption?.value} data-value={option.value}>
          {option.label}
        </button>
      ))}
    </div>
  </span>
</div>

<script>
  import '../../scripts/select'
</script>
