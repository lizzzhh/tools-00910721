---
import { Icon } from 'astro-icon/components'
import { localizeTools, plannedTools, tools } from '../data/tools'
import Button from './ui/Button.astro'
import Card from './ui/Card.astro'
import SectionHeading from './ui/SectionHeading.astro'
import { createTranslator } from '../i18n'
import { localePath } from '../i18n/config'

const locale = Astro.locals.locale
const t = createTranslator(locale)
const localizedTools = localizeTools(tools, t)
const localizedPlanned = localizeTools(plannedTools, t)
const toolsHref = localePath(locale, '/tools/')
---

<section class="dashboard-workspace" data-locale={locale}>
  <div class="dashboard-heading">
    <div>
      <span class="eyebrow">{t('home.eyebrow')}</span>
      <h1>{t('home.title')}</h1>
      <p>{t('home.subtitle')}</p>
    </div>
    <a class="primary-button" href={toolsHref}><Icon name="lucide:grid-2x2" size={17} />{t('home.cta')}</a>
  </div>

  <div class="dashboard-grid">
    <Card class="fortune-card">
      <SectionHeading eyebrow={t('home.fortune.eyebrow')} title={t('home.fortune.title')}>
        <span class="random-label">ONE DAILY</span>
      </SectionHeading>
      <div class="fortune-score-row">
        <strong id="fortune-score">--</strong><span>/ 100</span>
        <div class="fortune-meter"><i id="fortune-meter"></i></div>
      </div>
      <div class="fortune-copy">
        <span id="fortune-label">{t('home.fortune.idle')}</span>
        <p id="fortune-message">{t('home.fortune.idleMessage')}</p>
      </div>
      <Button id="draw-fortune" icon="lucide:sparkles">{t('home.fortune.draw')}</Button>
    </Card>

    <Card class="usage-card">
      <SectionHeading eyebrow={t('home.usage.eyebrow')} title={t('home.usage.title')}>
        <span class="local-label"><i></i>{t('home.usage.deviceOnly')}</span>
        <span class="activity-count">TOP 5</span>
      </SectionHeading>
      <div class="usage-metrics">
        <div><span>{t('home.usage.total')}</span><strong id="total-usage">0</strong><small>{t('home.usage.unit')}</small></div>
        <div><span>{t('home.usage.today')}</span><strong id="today-usage">0</strong><small>{t('home.usage.unit')}</small></div>
        <div><span>{t('home.usage.favorite')}</span><strong id="favorite-tool">{t('home.usage.none')}</strong><small id="favorite-count">{t('home.usage.times', { count: 0 })}</small></div>
      </div>
      <div class="usage-bars" id="usage-bars" hidden>
        {localizedTools.map((tool) => (
          <div class="usage-bar-row" data-tool-id={tool.id}>
            <div><span><Icon name={tool.icon} size={14} />{tool.name}</span><b data-tool-count>0</b></div>
            <i><span data-tool-bar></span></i>
          </div>
        ))}
      </div>
      <div class="usage-empty" id="usage-empty"><Icon name="lucide:chart-no-axes-column" size={18} /><span>{t('home.usage.empty')}<br /><small>{t('home.usage.emptyHint')}</small></span></div>
    </Card>
  </div>

  <div class="dashboard-lower-grid">
    <Card class="quick-tools">
        <SectionHeading eyebrow={t('home.quick.eyebrow')} title={t('home.quick.title')} />
      <div class="quick-tool-list">
        {localizedTools.map((tool) => (
          <a class="quick-tool" href={localePath(locale, `/tools/${tool.id}/`)}>
            <span class="quick-tool-icon"><Icon name={tool.icon} size={19} /></span>
            <span><strong>{tool.name}</strong><small>{tool.description}</small></span>
            <Icon name="lucide:arrow-up-right" size={16} />
          </a>
        ))}
        {localizedPlanned.slice(0, 3).map((tool) => (
          <div class="quick-tool coming">
            <span class="quick-tool-icon"><Icon name={tool.icon} size={19} /></span>
            <span><strong>{tool.name}</strong><small>{tool.description}</small></span>
            <em>{t('home.soon')}</em>
          </div>
        ))}
      </div>
    </Card>

    <Card class="activity-card">
      <SectionHeading eyebrow={t('home.activity.eyebrow')} title={t('home.activity.title')}>
        <span class="activity-count" id="activity-count">{t('home.activity.count', { count: 0 })}</span>
      </SectionHeading>
      <div class="activity-empty" id="activity-empty"><Icon name="lucide:history" size={18} /><span>{t('home.activity.empty')}<br /><small>{t('home.activity.emptyHint')}</small></span></div>
      <ol class="activity-list" id="activity-list" hidden></ol>
    </Card>
  </div>
</section>

<script>
  import '../scripts/dashboard'
</script>
