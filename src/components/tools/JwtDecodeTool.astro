---
import { Icon } from 'astro-icon/components'
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'
import { createTranslator } from '../../i18n'

const locale = Astro.locals.locale
const t = createTranslator(locale)
---

<section class="tool-workspace security-workspace" aria-live="polite">
  <div class="workspace-header">
    <div>
      <div class="breadcrumb"><span>{t('categories.security')}</span><b>/</b><strong>{t('tools.jwt-decode.name')}</strong></div>
      <div class="title-line">
        <span class="title-icon"><Icon name="lucide:key-round" size={25} /></span>
        <div><h1>{t('tools.jwt-decode.name')}</h1><p>{t('toolUi.jwt-decode.subtitle')}</p></div>
      </div>
    </div>
    <span class="privacy-badge"><Icon name="lucide:shield-check" size={16} />{t('common.localOnly')}</span>
  </div>

  <div class="security-notice"><Icon name="lucide:info" size={16} />{t('toolUi.jwt-decode.notice')}</div>

  <Card class="tool-card">
    <div class="field-heading">
      <label for="jwt-input">{t('toolUi.jwt-decode.inputLabel')}</label>
      <span><b id="jwt-char-count">0</b> {t('common.charactersUnit')}</span>
    </div>
    <div class="textarea-wrap">
      <textarea id="jwt-input" placeholder={t('toolUi.jwt-decode.inputPlaceholder')} spellcheck="false" autocomplete="off" autofocus></textarea>
    </div>
    <div class="security-error" id="jwt-error" role="alert" hidden></div>
    <div class="action-row">
      <Button id="jwt-decode" class="calculate-button" variant="primary" icon="lucide:scan-line">{t('toolUi.jwt-decode.decodeButton')}</Button>
      <Button id="jwt-clear" icon="lucide:trash-2">{t('common.clear')}</Button>
    </div>
  </Card>

  <Card id="jwt-result" class="result-card security-result-card" hidden>
    <div class="result-heading">
      <div><span class="status-dot"></span><strong>{t('toolUi.jwt-decode.resultTitle')}</strong></div>
      <span id="jwt-result-status">{t('toolUi.jwt-decode.idleStatus')}</span>
    </div>
    <div class="jwt-state" id="jwt-state" data-level="unknown">{t('toolUi.jwt-decode.idleState')}</div>
    <div class="jwt-claim-grid" id="jwt-claims"></div>
    <div class="jwt-json-grid">
      <div class="jwt-json-panel">
        <div class="result-subheading"><strong>Header</strong><button id="jwt-copy-header" type="button" class="inline-copy" disabled><Icon name="lucide:copy" size={14} />{t('common.copy')}</button></div>
        <pre id="jwt-header" class="security-code"></pre>
      </div>
      <div class="jwt-json-panel">
        <div class="result-subheading"><strong>Payload</strong><button id="jwt-copy-payload" type="button" class="inline-copy" disabled><Icon name="lucide:copy" size={14} />{t('common.copy')}</button></div>
        <pre id="jwt-payload" class="security-code"></pre>
      </div>
    </div>
    <ul class="security-warnings" id="jwt-warnings"></ul>
  </Card>
</section>

<script>
  import '../../scripts/jwt-decode'
</script>
