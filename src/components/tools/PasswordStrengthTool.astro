---
import { Icon } from 'astro-icon/components'
import CheckboxField from '../ui/CheckboxField.astro'
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'
---

<section class="tool-workspace security-workspace" aria-live="polite">
  <div class="workspace-header">
    <div>
      <div class="breadcrumb"><span>安全与加密</span><b>/</b><strong>密码强度检测</strong></div>
      <div class="title-line">
        <span class="title-icon"><Icon name="lucide:shield-check" size={25} /></span>
        <div><h1>密码强度检测</h1><p>在本地快速评估密码复杂度</p></div>
      </div>
    </div>
    <span class="privacy-badge"><Icon name="lucide:shield-check" size={16} />本地处理</span>
  </div>

  <div class="security-notice"><Icon name="lucide:info" size={16} />结果是基于长度、字符类型和常见模式的本地估算，不代表任何服务端的最终校验。</div>

  <Card class="tool-card">
    <div class="security-field">
      <div class="field-heading"><label for="password-strength-input">输入密码</label><div class="field-heading-actions"><CheckboxField id="password-strength-realtime" label="实时评估" checked /><CheckboxField id="password-strength-show" label="显示密码" /></div></div>
      <input class="security-input" id="password-strength-input" type="password" placeholder="输入要评估的密码…" spellcheck="false" autocomplete="new-password" autofocus />
    </div>
    <div class="action-row">
      <Button id="password-strength-evaluate" class="calculate-button" variant="primary" icon="lucide:scan-search">评估强度</Button>
      <Button id="password-strength-clear" icon="lucide:trash-2">清空</Button>
    </div>
  </Card>

  <Card class="result-card security-result-card" ariaLabel="密码强度结果">
    <div class="result-heading"><div><span class="status-dot"></span><strong>评估结果</strong></div><span id="password-strength-status">等待输入</span></div>
    <div class="strength-result" id="strength-result" data-level="empty">
      <div class="strength-score"><strong id="strength-score">—</strong><span>/ 100</span></div>
      <div class="strength-result-copy"><strong id="strength-label">等待输入</strong><div class="strength-track"><i id="strength-bar"></i></div><small id="strength-entropy">输入密码后显示熵值估算</small></div>
    </div>
    <div class="strength-metrics" id="strength-metrics"><span>长度 <b id="strength-length">0</b></span><span>字符种类 <b id="strength-classes">0</b></span><span>不同字符 <b id="strength-unique">0</b></span></div>
    <div class="strength-feedback"><strong>评估依据</strong><ul id="strength-messages"></ul><strong>建议</strong><ul id="strength-suggestions"></ul></div>
  </Card>
</section>

<script>
  import '../../scripts/password-strength'
</script>
