---
import { Icon } from 'astro-icon/components'
import CheckboxField from '../ui/CheckboxField.astro'
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'
import { createTranslator } from '../../i18n'

const t = createTranslator(Astro.locals.locale)
---

<section class="tool-workspace security-workspace" aria-live="polite">
  <div class="workspace-header">
    <div>
      <div class="breadcrumb"><span>{t('categories.security')}</span><b>/</b><strong>{t('tools.password-strength.name')}</strong></div>
      <div class="title-line">
        <span class="title-icon"><Icon name="lucide:shield-check" size={25} /></span>
        <div><h1>{t('tools.password-strength.name')}</h1><p>{t('toolUi.password-strength.subtitle')}</p></div>
      </div>
    </div>
    <span class="privacy-badge"><Icon name="lucide:shield-check" size={16} />{t('common.localOnly')}</span>
  </div>

  <div class="security-notice"><Icon name="lucide:info" size={16} />{t('toolUi.password-strength.notice')}</div>

  <Card class="tool-card">
    <div class="security-field">
      <div class="field-heading"><label for="password-strength-input">{t('toolUi.password-strength.inputLabel')}</label><div class="field-heading-actions"><CheckboxField id="password-strength-realtime" label={t('toolUi.password-strength.optLive')} checked /><CheckboxField id="password-strength-show" label={t('toolUi.password-strength.optShow')} /></div></div>
      <input class="security-input" id="password-strength-input" type="password" placeholder={t('toolUi.password-strength.inputPlaceholder')} spellcheck="false" autocomplete="new-password" autofocus />
    </div>
    <div class="action-row">
      <Button id="password-strength-evaluate" class="calculate-button" variant="primary" icon="lucide:scan-search">{t('toolUi.password-strength.runButton')}</Button>
      <Button id="password-strength-clear" icon="lucide:trash-2">{t('common.clear')}</Button>
    </div>
  </Card>

  <Card class="result-card security-result-card" ariaLabel={t('toolUi.password-strength.resultTitle')}>
    <div class="result-heading"><div><span class="status-dot"></span><strong>{t('toolUi.password-strength.resultLabel')}</strong></div><span id="password-strength-status">{t('workspace.waiting')}</span></div>
    <div class="strength-result" id="strength-result" data-level="empty">
      <div class="strength-score"><strong id="strength-score">—</strong><span>/ 100</span></div>
      <div class="strength-result-copy"><strong id="strength-label">{t('toolUi.password-strength.idleState')}</strong><div class="strength-track"><i id="strength-bar"></i></div><small id="strength-entropy">{t('toolUi.password-strength.idleHint')}</small></div>
    </div>
    <div class="strength-metrics" id="strength-metrics"><span>{t('toolUi.password-strength.statLength')} <b id="strength-length">0</b></span><span>{t('toolUi.password-strength.statClasses')} <b id="strength-classes">0</b></span><span>{t('toolUi.password-strength.statUnique')} <b id="strength-unique">0</b></span></div>
    <div class="strength-feedback"><strong>{t('toolUi.password-strength.basisLabel')}</strong><ul id="strength-messages"></ul><strong>{t('toolUi.password-strength.adviceLabel')}</strong><ul id="strength-suggestions"></ul></div>
  </Card>
</section>

<script>
  import '../../scripts/password-strength'
</script>
