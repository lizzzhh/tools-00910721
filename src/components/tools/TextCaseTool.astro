---
import { Icon } from 'astro-icon/components'
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'
import SelectField from '../ui/SelectField.astro'
import { caseStyleHints, caseStyleIds, type CaseStyle } from '../../lib/text'
import { createTranslator } from '../../i18n'

type Style = CaseStyle

const t = createTranslator(Astro.locals.locale)
const caseOptions = caseStyleIds.map((value) => ({ value, label: `${t(`toolUi.text-case.styles.${value}`)}（${caseStyleHints[value]}）` }))

const shortcutStyles: Style[] = ['camel', 'pascal', 'snake', 'kebab', 'constant', 'dot', 'path', 'title']
---

<section class="tool-workspace text-case-workspace">
  <div class="workspace-header">
    <div>
      <div class="breadcrumb"><span>{t('categories.text')}</span><b>/</b><strong>{t('tools.text-case.name')}</strong></div>
      <div class="title-line">
        <span class="title-icon"><Icon name="lucide:case-sensitive" size={25} /></span>
        <div><h1>{t('tools.text-case.name')}</h1><p>{t('toolUi.text-case.subtitle')}</p></div>
      </div>
    </div>
    <span class="privacy-badge"><Icon name="lucide:shield-check" size={16} />{t('common.localOnly')}</span>
  </div>

  <div class="security-notice"><Icon name="lucide:info" size={16} />{t('toolUi.text-case.notice')}</div>

  <Card class="tool-card">
    <div class="tool-options">
      <div class="tool-options-row">
        <SelectField id="text-case-style" label={t('toolUi.text-case.styleLabel')} options={caseOptions} value="camel" />
        <span>{t('toolUi.text-case.styleHint')}</span>
      </div>
    </div>
    <div class="field-heading">
      <label for="text-case-input">{t('workspace.inputLabel')}</label>
      <span><b id="text-case-char-count">0</b> {t('common.charactersUnit')}</span>
    </div>
    <div class="textarea-wrap">
      <textarea id="text-case-input" placeholder="hello world example" spellcheck="false" autocomplete="off" autofocus></textarea>
    </div>
    <div class="security-error" id="text-case-error" role="alert" hidden></div>
    <div class="action-row">
      <Button id="text-case-run" class="calculate-button" variant="primary" icon="lucide:case-sensitive"><span>{t('toolUi.text-case.startButton')}</span></Button>
      <Button id="text-case-sample" icon="lucide:wand-2">{t('common.sample')}</Button>
      <Button id="text-case-clear" icon="lucide:trash-2">{t('common.clear')}</Button>
    </div>
    <div class="tool-option-section">
      <span class="tool-option-heading">{t('toolUi.text-case.presets')}</span>
      <div class="tool-option-grid" id="text-case-shortcuts">
        {shortcutStyles.map((style) => (
          <button class="shortcut-button" type="button" data-style={style}>
            <strong>{t(`toolUi.text-case.styles.${style}`)}</strong>
            <code>{caseStyleHints[style]}</code>
          </button>
        ))}
      </div>
    </div>
  </Card>

  <Card id="text-case-result" class="result-card" hidden>
    <div class="result-heading">
      <div><span class="status-dot"></span><strong>{t('workspace.result')}</strong></div>
      <span id="text-case-result-status">{t('workspace.waiting')}</span>
    </div>
    <div class="result-subheading"><strong>{t('toolUi.text-case.resultTitle')}</strong><span>{t('workspace.readonly')}</span></div>
    <textarea id="text-case-output" class="tool-output" data-empty="true" readonly spellcheck="false" aria-label={t('toolUi.text-case.resultAria')}></textarea>
    <div class="tool-result-actions">
      <Button id="text-case-copy" icon="lucide:copy" disabled>{t('workspace.copyResult')}</Button>
      <Button id="text-case-download" icon="lucide:download" disabled>{t('workspace.downloadResult')}</Button>
    </div>
    <div class="tool-stats">
      <div><span>{t('toolUi.text-case.statWords')}</span><strong id="text-case-stat-words">—</strong></div>
      <div><span>{t('toolUi.text-case.statChars')}</span><strong id="text-case-stat-converted">—</strong></div>
      <div><span>{t('toolUi.text-case.statInputLength')}</span><strong id="text-case-stat-input">—</strong></div>
      <div><span>{t('toolUi.text-case.statOutputLength')}</span><strong id="text-case-stat-output">—</strong></div>
    </div>
  </Card>
</section>

<script>
  import '../../scripts/text-case'
</script>
