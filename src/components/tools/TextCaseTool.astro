---
import { Icon } from 'astro-icon/components'
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'
import SelectField from '../ui/SelectField.astro'
import { caseStyleHints, caseStyleLabels } from '../../lib/text'

type Style = keyof typeof caseStyleLabels

const caseOptions = (Object.keys(caseStyleLabels) as Style[]).map((value) => ({ value, label: `${caseStyleLabels[value]}（${caseStyleHints[value]}）` }))

const shortcutStyles: Style[] = ['camel', 'pascal', 'snake', 'kebab', 'constant', 'dot', 'path', 'title']
---

<section class="tool-workspace text-case-workspace">
  <div class="workspace-header">
    <div>
      <div class="breadcrumb"><span>文本处理</span><b>/</b><strong>大小写转换</strong></div>
      <div class="title-line">
        <span class="title-icon"><Icon name="lucide:case-sensitive" size={25} /></span>
        <div><h1>大小写转换</h1><p>命名风格与字符顺序转换</p></div>
      </div>
    </div>
    <span class="privacy-badge"><Icon name="lucide:shield-check" size={16} />本地处理</span>
  </div>

  <div class="security-notice"><Icon name="lucide:info" size={16} />自动识别驼峰、下划线、连字符与空格分隔，并保留中英文数字混排的可读性。</div>

  <Card class="tool-card">
    <div class="tool-options">
      <div class="tool-options-row">
        <SelectField id="text-case-style" label="目标风格" options={caseOptions} value="camel" />
        <span>常见命名风格会统一分隔符并按单词边界重新拼接。</span>
      </div>
    </div>
    <div class="field-heading">
      <label for="text-case-input">输入文本</label>
      <span><b id="text-case-char-count">0</b> 字符</span>
    </div>
    <div class="textarea-wrap">
      <textarea id="text-case-input" placeholder="hello world example" spellcheck="false" autocomplete="off" autofocus></textarea>
    </div>
    <div class="security-error" id="text-case-error" role="alert" hidden></div>
    <div class="action-row">
      <Button id="text-case-run" class="calculate-button" variant="primary" icon="lucide:case-sensitive"><span>开始转换</span></Button>
      <Button id="text-case-sample" icon="lucide:wand-2">示例</Button>
      <Button id="text-case-clear" icon="lucide:trash-2">清空</Button>
    </div>
    <div class="tool-option-section">
      <span class="tool-option-heading">常用风格</span>
      <div class="tool-option-grid" id="text-case-shortcuts">
        {shortcutStyles.map((style) => (
          <button class="shortcut-button" type="button" data-style={style}>
            <strong>{caseStyleLabels[style]}</strong>
            <code>{caseStyleHints[style]}</code>
          </button>
        ))}
      </div>
    </div>
  </Card>

  <Card id="text-case-result" class="result-card" hidden>
    <div class="result-heading">
      <div><span class="status-dot"></span><strong>转换结果</strong></div>
      <span id="text-case-result-status">等待处理</span>
    </div>
    <div class="result-subheading"><strong>结果</strong><span>只读结果</span></div>
    <textarea id="text-case-output" class="tool-output" data-empty="true" readonly spellcheck="false" aria-label="大小写转换结果"></textarea>
    <div class="tool-result-actions">
      <Button id="text-case-copy" icon="lucide:copy" disabled>复制结果</Button>
      <Button id="text-case-download" icon="lucide:download" disabled>下载结果</Button>
    </div>
    <div class="tool-stats">
      <div><span>识别单词</span><strong id="text-case-stat-words">—</strong></div>
      <div><span>转换字符</span><strong id="text-case-stat-converted">—</strong></div>
      <div><span>输入长度</span><strong id="text-case-stat-input">—</strong></div>
      <div><span>输出长度</span><strong id="text-case-stat-output">—</strong></div>
    </div>
  </Card>
</section>

<script>
  import '../../scripts/text-case'
</script>
