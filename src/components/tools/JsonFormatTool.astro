---
import { Icon } from 'astro-icon/components'
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'
import CheckboxField from '../ui/CheckboxField.astro'
import SelectField from '../ui/SelectField.astro'
import { createTranslator } from '../../i18n'

const indentOptions = [
  { value: '2', label: '2 个空格' },
  { value: '4', label: '4 个空格' },
  { value: 'tab', label: 'Tab' }
]

const quoteOptions = [
  { value: 'double', label: '双引号' },
  { value: 'single', label: '单引号' }
]

const t = createTranslator(Astro.locals.locale)
---

<section class="tool-workspace json-workspace" aria-live="polite">
  <div class="workspace-header">
    <div>
      <div class="breadcrumb"><span>{t('categories.encoding')}</span><b>/</b><strong>{t('tools.json-format.name')}</strong></div>
      <div class="title-line">
        <span class="title-icon"><Icon name="lucide:braces" size={25} /></span>
        <div><h1>{t('tools.json-format.name')}</h1><p>{t('toolUi.json-format.subtitle')}</p></div>
      </div>
    </div>
    <span class="privacy-badge"><Icon name="lucide:shield-check" size={16} />{t('common.localOnly')}</span>
  </div>

  <div class="security-notice"><Icon name="lucide:info" size={16} />{t('toolUi.json-format.notice')}</div>

  <Card class="tool-card">
    <div class="json-options">
      <div class="json-options-selects">
        <SelectField id="json-indent" label={t('toolUi.json-format.indentLabel')} options={indentOptions} value="2" />
        <SelectField id="json-quote" label={t('toolUi.json-format.quoteLabel')} options={quoteOptions} value="double" />
      </div>
      <div class="json-option-section">
        <span class="json-option-heading">{t('toolUi.json-format.parseHeading')}</span>
        <div class="json-option-grid">
          <CheckboxField id="json-relaxed" label={t('toolUi.json-format.optRelaxed')} checked />
          <CheckboxField id="json-allow-comments" label={t('toolUi.json-format.optComments')} checked />
          <CheckboxField id="json-allow-single-quotes" label={t('toolUi.json-format.optSingleQuotes')} checked />
          <CheckboxField id="json-allow-unquoted-keys" label={t('toolUi.json-format.optUnquotedKeys')} checked />
          <CheckboxField id="json-allow-trailing-commas" label={t('toolUi.json-format.optTrailingCommasIn')} checked />
          <CheckboxField id="json-allow-missing-commas" label={t('toolUi.json-format.optMissingCommas')} checked />
          <CheckboxField id="json-allow-missing-colons" label={t('toolUi.json-format.optMissingColons')} checked />
          <CheckboxField id="json-allow-undefined" label={t('toolUi.json-format.optUndefined')} checked />
        </div>
      </div>
      <div class="json-option-section">
        <span class="json-option-heading">{t('toolUi.json-format.outputHeading')}</span>
        <div class="json-option-grid">
          <CheckboxField id="json-sort-keys" label={t('toolUi.json-format.optSortKeys')} />
          <CheckboxField id="json-escape-unicode" label={t('toolUi.json-format.optEscapeUnicode')} />
          <CheckboxField id="json-trailing-commas" label={t('toolUi.json-format.optTrailingCommasOut')} />
          <CheckboxField id="json-array-line-breaks" label={t('toolUi.json-format.optArrayLineBreaks')} checked />
        </div>
      </div>
    </div>
    <div class="field-heading">
      <label for="json-input">{t('toolUi.json-format.inputLabel')}</label>
      <span><b id="json-char-count">0</b> {t('common.charactersUnit')}</span>
    </div>
    <div class="textarea-wrap">
      <textarea id="json-input" placeholder={'{\n  "name": "透明质的工具箱",\n  "enabled": true\n}'} spellcheck="false" autocomplete="off" autofocus></textarea>
    </div>
    <div class="security-error" id="json-error" role="alert" hidden></div>
    <div class="action-row">
      <Button id="json-format" class="calculate-button" variant="primary" icon="lucide:braces">{t('toolUi.json-format.formatButton')}</Button>
      <Button id="json-minify" icon="lucide:minimize-2">{t('toolUi.json-format.minifyButton')}</Button>
      <Button id="json-clear" icon="lucide:trash-2">{t('common.clear')}</Button>
    </div>
  </Card>

  <Card id="json-result" class="result-card json-result-card" hidden>
    <div class="result-heading">
      <div><span class="status-dot"></span><strong>{t('workspace.result')}</strong></div>
      <span id="json-result-status">{t('workspace.waiting')}</span>
    </div>
    <div class="json-repairs" id="json-repairs" role="status" hidden></div>
    <div class="result-subheading json-output-heading"><strong>{t('toolUi.json-format.outputTitle')}</strong><span>{t('workspace.readonly')}</span></div>
    <textarea id="json-output" class="json-output" data-empty="true" readonly spellcheck="false" aria-label={t('toolUi.json-format.outputAria')}></textarea>
    <div class="json-result-actions">
      <Button id="json-copy" icon="lucide:copy" disabled>{t('workspace.copyResult')}</Button>
      <Button id="json-download" icon="lucide:download" disabled>{t('toolUi.json-format.downloadButton')}</Button>
    </div>
    <div class="json-stats" id="json-stats">
      <div><span>{t('toolUi.json-format.statType')}</span><strong id="json-stat-type">—</strong></div>
      <div><span>{t('toolUi.json-format.statDepth')}</span><strong id="json-stat-depth">—</strong></div>
      <div><span>{t('toolUi.json-format.statKeys')}</span><strong id="json-stat-keys">—</strong></div>
      <div><span>{t('toolUi.json-format.statArrays')}</span><strong id="json-stat-arrays">—</strong></div>
      <div><span>{t('toolUi.json-format.statValues')}</span><strong id="json-stat-values">—</strong></div>
      <div><span>{t('toolUi.json-format.statSize')}</span><strong id="json-stat-bytes">—</strong></div>
    </div>
  </Card>
</section>

<script>
  import '../../scripts/json-format'
</script>
