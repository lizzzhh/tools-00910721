---
import { Icon } from 'astro-icon/components'
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'
import SelectField from '../ui/SelectField.astro'
import { createTranslator } from '../../i18n'

const t = createTranslator(Astro.locals.locale)

const ruleOptions = [
  { value: 'component', label: t('toolUi.url-encode.ruleComponent') },
  { value: 'uri', label: t('toolUi.url-encode.ruleUri') }
]
---

<section class="tool-workspace encoding-workspace url-workspace" aria-live="polite">
  <div class="workspace-header">
    <div>
      <div class="breadcrumb"><span>{t('categories.encoding')}</span><b>/</b><strong>{t('tools.url-encode.name')}</strong></div>
      <div class="title-line">
        <span class="title-icon"><Icon name="lucide:link-2" size={25} /></span>
        <div><h1>{t('tools.url-encode.name')}</h1><p>{t('toolUi.url-encode.subtitle')}</p></div>
      </div>
    </div>
    <span class="privacy-badge"><Icon name="lucide:shield-check" size={16} />{t('common.localOnly')}</span>
  </div>

  <div class="security-notice"><Icon name="lucide:info" size={16} />{t('toolUi.url-encode.notice')}</div>

  <Card class="tool-card">
    <div class="input-mode" role="tablist" aria-label={t('toolUi.url-encode.operationLabel')}>
      <button class="mode-button active" id="url-encode-tab" type="button" role="tab" aria-selected="true" aria-controls="url-panel" data-mode="encode"><Icon name="lucide:arrow-up-from-line" size={17} />{t('toolUi.url-encode.opEncode')}</button>
      <button class="mode-button" id="url-decode-tab" type="button" role="tab" aria-selected="false" aria-controls="url-panel" data-mode="decode"><Icon name="lucide:arrow-down-to-line" size={17} />{t('toolUi.url-encode.opDecode')}</button>
    </div>
    <div class="encoding-options url-options">
      <SelectField id="url-rule" label={t('toolUi.url-encode.ruleLabel')} options={ruleOptions} value="component" />
      <span>{t('toolUi.url-encode.ruleHint')}</span>
    </div>
    <div class="mode-panel active" id="url-panel" role="tabpanel" aria-labelledby="url-encode-tab" data-panel="encode">
      <div class="field-heading">
        <label for="url-input" id="url-input-label">{t('toolUi.url-encode.inputLabel')}</label>
        <span><b id="url-char-count">0</b> {t('common.charactersUnit')}</span>
      </div>
      <div class="textarea-wrap">
        <textarea id="url-input" placeholder={t('toolUi.url-encode.inputPlaceholder')} spellcheck="false" autocomplete="off" autofocus></textarea>
      </div>
    </div>
    <div class="security-error" id="url-error" role="alert" hidden></div>
    <div class="action-row">
      <Button id="url-process" class="calculate-button" variant="primary" icon="lucide:link-2"><span id="url-process-label">{t('toolUi.url-encode.encodeButton')}</span></Button>
      <Button id="url-clear" icon="lucide:trash-2">{t('common.clear')}</Button>
    </div>
  </Card>

  <Card id="url-result" class="result-card encoding-result-card" hidden>
    <div class="result-heading">
      <div><span class="status-dot"></span><strong>{t('workspace.result')}</strong></div>
      <span id="url-result-status">{t('workspace.waiting')}</span>
    </div>
    <div class="result-subheading encoding-output-heading"><strong id="url-output-label">{t('toolUi.url-encode.resultTitle')}</strong><span>{t('workspace.readonly')}</span></div>
    <textarea id="url-output" class="encoding-output" data-empty="true" readonly spellcheck="false" aria-label={t('toolUi.url-encode.resultLabel')}></textarea>
    <div class="encoding-result-actions">
      <Button id="url-copy" icon="lucide:copy" disabled>{t('workspace.copyResult')}</Button>
      <Button id="url-download" icon="lucide:download" disabled>{t('workspace.downloadResult')}</Button>
    </div>
    <div class="encoding-stats">
      <div><span>{t('workspace.inputChars')}</span><strong id="url-stat-input">—</strong></div>
      <div><span>{t('workspace.outputChars')}</span><strong id="url-stat-output">—</strong></div>
      <div><span>{t('workspace.bytes')}</span><strong id="url-stat-bytes">—</strong></div>
      <div><span>{t('toolUi.url-encode.statRule')}</span><strong id="url-stat-rule">—</strong></div>
    </div>
  </Card>
</section>

<script>
  import '../../scripts/url-encode'
</script>
