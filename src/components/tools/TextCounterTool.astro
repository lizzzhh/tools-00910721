---
import { Icon } from 'astro-icon/components'
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'
import { createTranslator } from '../../i18n'

const t = createTranslator(Astro.locals.locale)
---

<section class="tool-workspace text-counter-workspace">
  <div class="workspace-header">
    <div>
      <div class="breadcrumb"><span>{t('categories.text')}</span><b>/</b><strong>{t('tools.text-counter.name')}</strong></div>
      <div class="title-line">
        <span class="title-icon"><Icon name="lucide:bar-chart-3" size={25} /></span>
        <div><h1>{t('tools.text-counter.name')}</h1><p>{t('toolUi.text-counter.subtitle')}</p></div>
      </div>
    </div>
    <span class="privacy-badge"><Icon name="lucide:shield-check" size={16} />{t('common.localOnly')}</span>
  </div>

  <div class="security-notice"><Icon name="lucide:info" size={16} />{t('toolUi.text-counter.notice')}</div>

  <Card class="tool-card">
    <div class="field-heading">
      <label for="text-counter-input">{t('workspace.inputLabel')}</label>
      <span><b id="text-counter-char-count">0</b> {t('common.charactersUnit')}</span>
    </div>
    <div class="textarea-wrap">
      <textarea id="text-counter-input" placeholder={t('toolUi.text-counter.inputPlaceholder')} spellcheck="false" autocomplete="off" autofocus></textarea>
    </div>
    <div class="action-row">
      <Button id="text-counter-sample" icon="lucide:wand-2">{t('common.sample')}</Button>
      <Button id="text-counter-clear" icon="lucide:trash-2">{t('common.clear')}</Button>
    </div>
  </Card>

  <Card id="text-counter-result" class="result-card" hidden>
    <div class="result-heading">
      <div><span class="status-dot"></span><strong>{t('workspace.result')}</strong></div>
      <span id="text-counter-result-status">{t('workspace.waiting')}</span>
    </div>
    <div class="tool-stats">
      <div><span>{t('toolUi.text-counter.statChars')}</span><strong id="text-counter-stat-characters">0</strong></div>
      <div><span>{t('toolUi.text-counter.statNoSpaces')}</span><strong id="text-counter-stat-no-spaces">0</strong></div>
      <div><span>{t('toolUi.text-counter.statWords')}</span><strong id="text-counter-stat-words">0</strong></div>
      <div><span>{t('toolUi.text-counter.statUniqueWords')}</span><strong id="text-counter-stat-unique">0</strong></div>
      <div><span>{t('toolUi.text-counter.statLines')}</span><strong id="text-counter-stat-lines">0</strong></div>
      <div><span>{t('toolUi.text-counter.statParagraphs')}</span><strong id="text-counter-stat-paragraphs">0</strong></div>
      <div><span>{t('toolUi.text-counter.statSentences')}</span><strong id="text-counter-stat-sentences">0</strong></div>
      <div><span>{t('toolUi.text-counter.statBytes')}</span><strong id="text-counter-stat-bytes">0</strong></div>
      <div><span>{t('toolUi.text-counter.statCjk')}</span><strong id="text-counter-stat-cjk">0</strong></div>
      <div><span>{t('toolUi.text-counter.statLatin')}</span><strong id="text-counter-stat-letters">0</strong></div>
      <div><span>{t('toolUi.text-counter.statDigits')}</span><strong id="text-counter-stat-digits">0</strong></div>
      <div><span>{t('toolUi.text-counter.statPunctuation')}</span><strong id="text-counter-stat-punctuation">0</strong></div>
      <div><span>{t('toolUi.text-counter.statWhitespace')}</span><strong id="text-counter-stat-whitespace">0</strong></div>
      <div><span>{t('toolUi.text-counter.statLongestWord')}</span><strong id="text-counter-stat-longest">0</strong></div>
      <div><span>{t('toolUi.text-counter.statReading')}</span><strong id="text-counter-stat-reading">{t('toolUi.text-counter.minutesUnit', { count: 0 })}</strong></div>
    </div>
  </Card>
</section>

<script>
  import '../../scripts/text-counter'
</script>
