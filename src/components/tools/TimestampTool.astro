---
import { Icon } from 'astro-icon/components'
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'
import CheckboxField from '../ui/CheckboxField.astro'
import SelectField from '../ui/SelectField.astro'
import { createTranslator } from '../../i18n'

const t = createTranslator(Astro.locals.locale)

const unitOptions = [
  { value: 'auto', label: t('toolUi.timestamp-converter.modeAuto') },
  { value: 'seconds', label: t('toolUi.timestamp-converter.unitSeconds') },
  { value: 'milliseconds', label: t('toolUi.timestamp-converter.unitMilliseconds') }
]
---

<section class="tool-workspace timestamp-workspace">
  <div class="workspace-header">
    <div>
      <div class="breadcrumb"><span>{t('categories.encoding')}</span><b>/</b><strong>{t('tools.timestamp-converter.name')}</strong></div>
      <div class="title-line">
        <span class="title-icon"><Icon name="lucide:calendar-clock" size={25} /></span>
        <div><h1>{t('tools.timestamp-converter.name')}</h1><p>{t('toolUi.timestamp-converter.subtitle')}</p></div>
      </div>
    </div>
    <span class="privacy-badge"><Icon name="lucide:shield-check" size={16} />{t('common.localOnly')}</span>
  </div>

  <div class="security-notice"><Icon name="lucide:info" size={16} />{t('toolUi.timestamp-converter.notice')}</div>

  <Card class="tool-card">
    <div class="input-mode" role="tablist" aria-label={t('toolUi.timestamp-converter.directionLabel')}>
      <button class="mode-button active" id="timestamp-from-tab" type="button" role="tab" aria-selected="true" aria-controls="timestamp-panel" data-mode="from-timestamp"><Icon name="lucide:hash" size={17} />{t('toolUi.timestamp-converter.dirToDate')}</button>
      <button class="mode-button" id="timestamp-date-tab" type="button" role="tab" aria-selected="false" aria-controls="timestamp-panel" data-mode="from-date"><Icon name="lucide:calendar" size={17} />{t('toolUi.timestamp-converter.dirToTimestamp')}</button>
    </div>
    <div class="tool-options">
      <div class="tool-options-row" id="timestamp-unit-row">
        <SelectField id="timestamp-unit" label={t('toolUi.timestamp-converter.unitLabel')} options={unitOptions} value="auto" />
        <span id="timestamp-hint">{t('toolUi.timestamp-converter.unitHint')}</span>
      </div>
      <div class="tool-options-row" id="timestamp-utc-row" hidden>
        <CheckboxField id="timestamp-assume-utc" label={t('toolUi.timestamp-converter.optUtc')} />
      </div>
    </div>
    <div class="mode-panel active" id="timestamp-panel" role="tabpanel" aria-labelledby="timestamp-from-tab" data-panel="from-timestamp">
      <div class="field-heading">
        <label for="timestamp-input" id="timestamp-input-label">{t('toolUi.timestamp-converter.inputLabel')}</label>
        <span>{t('toolUi.timestamp-converter.inputHint')}</span>
      </div>
      <div class="textarea-wrap">
        <textarea id="timestamp-input" class="textarea-compact" spellcheck="false" autocomplete="off" placeholder="1767225600" autofocus></textarea>
      </div>
    </div>
    <div class="security-error" id="timestamp-error" role="alert" hidden></div>
    <div class="action-row">
      <Button id="timestamp-run" class="calculate-button" variant="primary" icon="lucide:calendar-clock"><span>{t('toolUi.timestamp-converter.startButton')}</span></Button>
      <Button id="timestamp-now" icon="lucide:clock">{t('toolUi.timestamp-converter.nowButton')}</Button>
      <Button id="timestamp-clear" icon="lucide:trash-2">{t('common.clear')}</Button>
    </div>
  </Card>

  <Card id="timestamp-result" class="result-card" hidden>
    <div class="result-heading">
      <div><span class="status-dot"></span><strong>{t('workspace.result')}</strong></div>
      <span id="timestamp-result-status">{t('workspace.waiting')}</span>
    </div>
    <div class="result-subheading"><strong>{t('toolUi.timestamp-converter.detailsTitle')}</strong><span>{t('toolUi.timestamp-converter.detailsHint')}</span></div>
    <div class="tool-rows" id="timestamp-rows"></div>
  </Card>
</section>

<script>
  import '../../scripts/timestamp'
</script>
