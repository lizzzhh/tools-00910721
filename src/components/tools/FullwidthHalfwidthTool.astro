---
import { Icon } from 'astro-icon/components'
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'
import CheckboxField from '../ui/CheckboxField.astro'
import SelectField from '../ui/SelectField.astro'
import { createTranslator } from '../../i18n'

const t = createTranslator(Astro.locals.locale)

const directionOptions = [
  { value: 'to-half', label: t('toolUi.fullwidth-halfwidth.dirToHalf') },
  { value: 'to-full', label: t('toolUi.fullwidth-halfwidth.dirToFull') }
]
---

<section class="tool-workspace fullwidth-workspace">
  <div class="workspace-header">
    <div>
      <div class="breadcrumb"><span>{t('categories.text')}</span><b>/</b><strong>{t('tools.fullwidth-halfwidth.name')}</strong></div>
      <div class="title-line">
        <span class="title-icon"><Icon name="lucide:arrow-left-right" size={25} /></span>
        <div><h1>{t('tools.fullwidth-halfwidth.name')}</h1><p>{t('toolUi.fullwidth-halfwidth.subtitle')}</p></div>
      </div>
    </div>
    <span class="privacy-badge"><Icon name="lucide:shield-check" size={16} />{t('common.localOnly')}</span>
  </div>

  <div class="security-notice"><Icon name="lucide:info" size={16} />{t('toolUi.fullwidth-halfwidth.notice')}</div>

  <Card class="tool-card">
    <div class="tool-options">
      <div class="tool-options-row">
        <SelectField id="fullwidth-mode" label={t('toolUi.fullwidth-halfwidth.directionLabel')} options={directionOptions} value="to-half" />
        <span>{t('toolUi.fullwidth-halfwidth.directionHint')}</span>
      </div>
      <div class="tool-option-section">
        <span class="tool-option-heading">{t('toolUi.fullwidth-halfwidth.optionsLabel')}</span>
        <div class="tool-option-grid">
          <CheckboxField id="fullwidth-keep-space" label={t('toolUi.fullwidth-halfwidth.optKeepSpaces')} />
        </div>
      </div>
    </div>
    <div class="field-heading">
      <label for="fullwidth-input">{t('toolUi.fullwidth-halfwidth.inputLabel')}</label>
      <span><b id="fullwidth-char-count">0</b> {t('common.charactersUnit')}</span>
    </div>
    <div class="textarea-wrap">
      <textarea id="fullwidth-input" spellcheck="false" autocomplete="off" autofocus placeholder={t('toolUi.fullwidth-halfwidth.inputPlaceholder')}></textarea>
    </div>
    <div class="security-error" id="fullwidth-error" role="alert" hidden></div>
    <div class="action-row">
      <Button id="fullwidth-run" class="calculate-button" variant="primary" icon="lucide:arrow-left-right"><span>{t('toolUi.fullwidth-halfwidth.runButton')}</span></Button>
      <Button id="fullwidth-sample" icon="lucide:wand-2">{t('common.sample')}</Button>
      <Button id="fullwidth-clear" icon="lucide:trash-2">{t('common.clear')}</Button>
    </div>
  </Card>

  <Card id="fullwidth-result" class="result-card" hidden>
    <div class="result-heading">
      <div><span class="status-dot"></span><strong>{t('workspace.result')}</strong></div>
      <span id="fullwidth-result-status">{t('workspace.waiting')}</span>
    </div>
    <div class="result-subheading"><strong>{t('toolUi.fullwidth-halfwidth.resultTitle')}</strong><span>{t('workspace.readonly')}</span></div>
    <textarea id="fullwidth-output" class="tool-output" data-empty="true" readonly spellcheck="false" aria-label={t('toolUi.fullwidth-halfwidth.resultLabel')}></textarea>
    <div class="tool-result-actions">
      <Button id="fullwidth-copy" icon="lucide:copy" disabled>{t('workspace.copyResult')}</Button>
      <Button id="fullwidth-download" icon="lucide:download" disabled>{t('workspace.downloadResult')}</Button>
    </div>
    <div class="tool-stats">
      <div><span>{t('toolUi.fullwidth-halfwidth.statConverted')}</span><strong id="fullwidth-stat-converted">—</strong></div>
      <div><span>{t('toolUi.fullwidth-halfwidth.statUntouched')}</span><strong id="fullwidth-stat-unchanged">—</strong></div>
      <div><span>{t('toolUi.fullwidth-halfwidth.statInputLength')}</span><strong id="fullwidth-stat-input">—</strong></div>
      <div><span>{t('toolUi.fullwidth-halfwidth.statOutputLength')}</span><strong id="fullwidth-stat-output">—</strong></div>
    </div>
  </Card>
</section>

<script>
  import '../../scripts/fullwidth-halfwidth'
</script>
