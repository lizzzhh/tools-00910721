---
import { Icon } from 'astro-icon/components'
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'
import CheckboxField from '../ui/CheckboxField.astro'
import { createTranslator } from '../../i18n'

const t = createTranslator(Astro.locals.locale)
---

<section class="tool-workspace query-string-workspace">
  <div class="workspace-header">
    <div>
      <div class="breadcrumb"><span>{t('categories.encoding')}</span><b>/</b><strong>{t('tools.query-string.name')}</strong></div>
      <div class="title-line">
        <span class="title-icon"><Icon name="lucide:list-ordered" size={25} /></span>
        <div><h1>{t('tools.query-string.name')}</h1><p>{t('toolUi.query-string.subtitle')}</p></div>
      </div>
    </div>
    <span class="privacy-badge"><Icon name="lucide:shield-check" size={16} />{t('common.localOnly')}</span>
  </div>

  <div class="security-notice"><Icon name="lucide:info" size={16} />{t('toolUi.query-string.noticeLead1')}<code>{t('toolUi.query-string.noticeCode1')}</code>{t('toolUi.query-string.noticeMid1')}<code>{t('toolUi.query-string.noticeCode2')}</code>{t('toolUi.query-string.noticeLead2')}</div>

  <Card class="tool-card">
    <div class="field-heading">
      <label for="query-input">{t('toolUi.query-string.inputLabel')}</label>
      <span><b id="query-char-count">0</b> {t('common.charactersUnit')}</span>
    </div>
    <div class="textarea-wrap">
      <textarea id="query-input" spellcheck="false" autocomplete="off" autofocus placeholder={t('toolUi.query-string.inputPlaceholder')}></textarea>
    </div>
    <div class="security-error" id="query-error" role="alert" hidden></div>
    <div class="action-row">
      <Button id="query-sample" icon="lucide:wand-2">{t('common.sample')}</Button>
      <Button id="query-clear" icon="lucide:trash-2">{t('common.clear')}</Button>
      <span class="action-row-hint">{t('toolUi.query-string.editHint')}</span>
    </div>
    <div class="tool-options">
      <div class="tool-option-section">
        <span class="tool-option-heading">{t('toolUi.query-string.outputLabel')}</span>
        <div class="tool-option-grid">
          <CheckboxField id="query-encode" label={t('toolUi.query-string.optEncode')} checked />
          <CheckboxField id="query-plus" label={t('toolUi.query-string.optPlus')} />
          <CheckboxField id="query-keep-empty" label={t('toolUi.query-string.optKeepEmpty')} checked />
          <CheckboxField id="query-sort" label={t('toolUi.query-string.optSort')} />
          <CheckboxField id="query-prefix" label={t('toolUi.query-string.optPrefix')} />
          <CheckboxField id="query-append-hash" label={t('toolUi.query-string.optAppendHash')} />
        </div>
      </div>
    </div>
  </Card>

  <Card id="query-result" class="result-card">
    <div class="result-heading">
      <div><span class="status-dot"></span><strong>{t('toolUi.query-string.tableTitle')}</strong></div>
      <span id="query-result-status">{t('workspace.waiting')}</span>
    </div>

    <div class="field-heading tool-filter-bar">
      <label for="query-filter">{t('toolUi.query-string.filterLabel')}</label>
      <div class="field-heading-actions">
        <input id="query-filter" type="text" placeholder={t('toolUi.query-string.filterPlaceholder')} autocomplete="off" spellcheck="false" />
        <Button id="query-add" icon="lucide:plus">{t('toolUi.query-string.addButton')}</Button>
      </div>
    </div>

    <div class="query-source" id="query-source" hidden>
      <span class="query-source-label">{t('toolUi.query-string.sourceLabel')}</span>
      <code id="query-source-value"></code>
    </div>

    <div class="query-table">
      <div class="query-row query-row-head">
        <span>#</span>
        <span>{t('toolUi.query-string.colKey')}</span>
        <span>{t('toolUi.query-string.colValue')}</span>
        <span class="query-row-head-actions">{t('toolUi.query-string.colActions')}</span>
      </div>
      <div id="query-rows"></div>
      <p class="tool-empty-note" id="query-empty-state" hidden></p>
    </div>

    <div class="security-error query-warning" id="query-duplicate-warning" role="status" hidden></div>

    <div class="result-subheading tool-subsection"><strong>{t('toolUi.query-string.outputHeading')}</strong><span>{t('toolUi.query-string.outputHeadingHint')}</span></div>
    <div class="query-output-row">
      <input id="query-output" class="query-output" type="text" readonly spellcheck="false" autocomplete="off" title={t('toolUi.query-string.outputTitle')} placeholder={t('toolUi.query-string.outputPlaceholder')} aria-label={t('toolUi.query-string.outputAria')} />
      <Button id="query-download" icon="lucide:download" disabled>{t('toolUi.query-string.downloadButton')}</Button>
    </div>
    <div class="tool-stats">
      <div><span>{t('toolUi.query-string.statCount')}</span><strong id="query-stat-count">—</strong></div>
      <div><span>{t('toolUi.query-string.statKeys')}</span><strong id="query-stat-keys">—</strong></div>
      <div><span>{t('toolUi.query-string.statDuplicates')}</span><strong id="query-stat-duplicates">—</strong></div>
      <div><span>{t('toolUi.query-string.statLength')}</span><strong id="query-stat-length">—</strong></div>
    </div>
  </Card>
</section>

<script>
  import '../../scripts/query-string'
</script>
