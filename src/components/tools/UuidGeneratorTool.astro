---
import { Icon } from 'astro-icon/components'
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'
import SelectField from '../ui/SelectField.astro'
import { uuidDomains, uuidNamespaces, uuidVersions } from '../../lib/uuid'
import { createTranslator } from '../../i18n'
import { localePath } from '../../i18n/config'

const t = createTranslator(Astro.locals.locale)
const parserHref = localePath(Astro.locals.locale, '/tools/uuid-parser/')

const versionOptions = uuidVersions.map((spec) => ({ value: String(spec.version), label: t(`uuidUi.names.${spec.nameId}`) }))
const namespaceOptions = uuidNamespaces.map((item) => ({ value: item.id, label: t(`uuidUi.namespaces.${item.id}`) }))
const domainOptions = uuidDomains.map((item) => ({ value: String(item.value), label: t(`uuidUi.domains.${item.id}`) }))
const caseOptions = [
  { value: 'lower', label: t('toolUi.uuid-generator.caseLower') },
  { value: 'upper', label: t('toolUi.uuid-generator.caseUpper') }
]
const formatOptions = [
  { value: 'standard', label: t('toolUi.uuid-generator.formatStandard') },
  { value: 'compact', label: t('toolUi.uuid-generator.formatCompact') },
  { value: 'braces', label: t('toolUi.uuid-generator.formatBraces') }
]
---

<section class="tool-workspace uuid-workspace">
  <div class="workspace-header">
    <div>
      <div class="breadcrumb"><span>{t('categories.encoding')}</span><b>/</b><strong>{t('tools.uuid-generator.name')}</strong></div>
      <div class="title-line">
        <span class="title-icon"><Icon name="lucide:fingerprint" size={25} /></span>
        <div><h1>{t('tools.uuid-generator.name')}</h1><p>{t('toolUi.uuid-generator.subtitle')}</p></div>
      </div>
    </div>
    <span class="privacy-badge"><Icon name="lucide:shield-check" size={16} />{t('common.localOnly')}</span>
  </div>

  <div class="security-notice"><Icon name="lucide:info" size={16} /><span>{t('toolUi.uuid-generator.noticeLead')} <a href={parserHref}>{t('toolUi.uuid-generator.noticeLink')}</a>{t('toolUi.uuid-generator.noticeTail')}</span></div>

  <Card class="tool-card">
    <div class="tool-field-grid">
      <SelectField id="uuid-version" label={t('toolUi.uuid-generator.versionLabel')} options={versionOptions} value="4" />
      <div class="tool-field">
        <label for="uuid-count">{t('toolUi.uuid-generator.countLabel')}</label>
        <input id="uuid-count" type="number" min="1" max="1000" value="5" autocomplete="off" />
      </div>
    </div>
    <div class="tool-options">
      <div class="tool-options-row">
        <SelectField id="uuid-case" label={t('toolUi.uuid-generator.caseLabel')} options={caseOptions} value="lower" />
        <SelectField id="uuid-format" label={t('toolUi.uuid-generator.formatLabel')} options={formatOptions} value="standard" />
        <div class="tool-field">
          <label for="uuid-prefix">{t('toolUi.uuid-generator.prefixLabel')}</label>
          <input id="uuid-prefix" type="text" value="" placeholder={t('toolUi.uuid-generator.prefixPlaceholder')} autocomplete="off" spellcheck="false" />
        </div>
      </div>
      <div class="tool-option-section" id="uuid-name-section" hidden>
        <span class="tool-option-heading">{t('toolUi.uuid-generator.namespaceHeading')}</span>
        <div class="tool-options-row">
          <SelectField id="uuid-namespace" label={t('toolUi.uuid-generator.namespaceLabel')} options={namespaceOptions} value="dns" />
          <div class="tool-field">
            <label for="uuid-name">{t('toolUi.uuid-generator.nameLabel')}</label>
            <input id="uuid-name" type="text" value="" placeholder={t('toolUi.uuid-generator.namePlaceholder')} autocomplete="off" spellcheck="false" />
          </div>
        </div>
        <div class="tool-field" id="uuid-namespace-field" hidden>
          <div class="field-heading"><label for="uuid-namespace-hex">{t('toolUi.uuid-generator.namespaceValueLabel')}</label><span>{t('toolUi.uuid-generator.namespaceValueHint')}</span></div>
          <input id="uuid-namespace-hex" type="text" value="" placeholder="6ba7b8109dad11d180b400c04fd430c8" autocomplete="off" spellcheck="false" />
        </div>
      </div>
      <div class="tool-option-section" id="uuid-domain-section" hidden>
        <span class="tool-option-heading">{t('toolUi.uuid-generator.domainHeading')}</span>
        <div class="tool-options-row">
          <SelectField id="uuid-domain" label={t('toolUi.uuid-generator.domainLabel')} options={domainOptions} value="0" />
        </div>
      </div>
    </div>
    <div class="security-error" id="uuid-error" role="alert" hidden></div>
    <div class="action-row">
      <Button id="uuid-run" class="calculate-button" variant="primary" icon="lucide:fingerprint"><span>{t('toolUi.uuid-generator.runButton')}</span></Button>
      <Button id="uuid-clear" icon="lucide:trash-2">{t('common.clear')}</Button>
    </div>
  </Card>

  <Card id="uuid-result" class="result-card" hidden>
    <div class="result-heading">
      <div><span class="status-dot"></span><strong>{t('toolUi.uuid-generator.resultLabel')}</strong></div>
      <span id="uuid-result-status">{t('toolUi.uuid-generator.idleStatus')}</span>
    </div>
    <div class="result-subheading"><strong>{t('toolUi.uuid-generator.listTitle')}</strong><span>{t('toolUi.uuid-generator.listHint')}</span></div>
    <textarea id="uuid-output" class="tool-output" data-empty="true" readonly spellcheck="false" aria-label={t('toolUi.uuid-generator.listAria')}></textarea>
    <div class="tool-result-actions">
      <Button id="uuid-copy" icon="lucide:copy" disabled>{t('workspace.copyResult')}</Button>
      <Button id="uuid-download" icon="lucide:download" disabled>{t('workspace.downloadResult')}</Button>
    </div>
    <div class="tool-stats">
      <div><span>{t('toolUi.uuid-generator.statCount')}</span><strong id="uuid-stat-count">—</strong></div>
      <div><span>{t('toolUi.uuid-generator.statVersion')}</span><strong id="uuid-stat-version">—</strong></div>
      <div><span>{t('toolUi.uuid-generator.statKind')}</span><strong id="uuid-stat-kind">—</strong></div>
      <div><span>{t('toolUi.uuid-generator.statLength')}</span><strong id="uuid-stat-length">—</strong></div>
    </div>
  </Card>

  <Card class="tool-card">
    <div class="result-subheading tool-subsection"><strong>{t('toolUi.uuid-generator.versionsTitle')}</strong><span>{t('toolUi.uuid-generator.versionsHint')}</span></div>
    <div class="tool-rows">
      {uuidVersions.map((spec) => (
        <div class="tool-row">
          <span>{t(`uuidUi.names.${spec.nameId}`)}</span>
          <span>{t(`uuidUi.summaries.${spec.summaryId}`)}</span>
        </div>
      ))}
    </div>
  </Card>
</section>

<script>
  import '../../scripts/uuid-generator'
</script>
