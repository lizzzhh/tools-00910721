---
import { Icon } from 'astro-icon/components'
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'
import SelectField from '../ui/SelectField.astro'
import { createTranslator } from '../../i18n'

const t = createTranslator(Astro.locals.locale)

const encodingValues = ['base32', 'base58', 'base62', 'base64', 'base85', 'base91'] as const
const encodingOptions = encodingValues.map((value) => ({
  value,
  label: t(`toolUi.base64.algorithms.${value}`)
}))
---

<section class="tool-workspace encoding-workspace base64-workspace" aria-live="polite">
  <div class="workspace-header">
    <div>
      <div class="breadcrumb"><span>{t('categories.encoding')}</span><b>/</b><strong>{t('tools.base64.name')}</strong></div>
      <div class="title-line">
        <span class="title-icon"><Icon name="lucide:binary" size={25} /></span>
        <div><h1>{t('tools.base64.name')}</h1><p>{t('toolUi.base64.subtitle')}</p></div>
      </div>
    </div>
    <span class="privacy-badge"><Icon name="lucide:shield-check" size={16} />{t('common.localOnly')}</span>
  </div>

  <div class="security-notice"><Icon name="lucide:info" size={16} />{t('toolUi.base64.notice')}</div>

  <Card class="tool-card">
    <div class="input-mode" role="tablist" aria-label={t('toolUi.base64.modeLabel')}>
      <button class="mode-button active" id="base64-encode-tab" type="button" role="tab" aria-selected="true" aria-controls="base64-panel" data-mode="encode"><Icon name="lucide:arrow-up-from-line" size={17} />{t('common.encode')}</button>
      <button class="mode-button" id="base64-decode-tab" type="button" role="tab" aria-selected="false" aria-controls="base64-panel" data-mode="decode"><Icon name="lucide:arrow-down-to-line" size={17} />{t('common.decode')}</button>
    </div>
    <div class="encoding-options base-encoding-options">
      <SelectField id="base-encoding" label={t('workspace.algorithm')} options={encodingOptions} value="base64" />
      <span>{t('toolUi.base64.algorithmHint')}</span>
    </div>
    <div class="mode-panel active" id="base64-panel" role="tabpanel" aria-labelledby="base64-encode-tab" data-panel="encode">
      <div class="field-heading">
        <label for="base64-input" id="base64-input-label">{t('workspace.inputLabel')}</label>
        <span><b id="base64-char-count">0</b> {t('common.charactersUnit')}</span>
      </div>
      <div class="textarea-wrap">
        <textarea id="base64-input" placeholder={t('toolUi.base64.inputPlaceholder')} spellcheck="false" autocomplete="off" autofocus></textarea>
      </div>
    </div>
    <div class="security-error" id="base64-error" role="alert" hidden></div>
    <div class="action-row">
      <Button id="base64-process" class="calculate-button" variant="primary" icon="lucide:binary"><span id="base64-process-label">{t('workspace.startEncode')}</span></Button>
      <Button id="base64-clear" icon="lucide:trash-2">{t('common.clear')}</Button>
    </div>
  </Card>

  <Card id="base64-result" class="result-card encoding-result-card" hidden>
    <div class="result-heading">
      <div><span class="status-dot"></span><strong>{t('workspace.result')}</strong></div>
      <span id="base64-result-status">{t('workspace.waiting')}</span>
    </div>
    <div class="result-subheading encoding-output-heading"><strong id="base64-output-label">{t('workspace.encodedResult')}</strong><span>{t('workspace.readonly')}</span></div>
    <textarea id="base64-output" class="encoding-output" data-empty="true" readonly spellcheck="false" aria-label={t('toolUi.base64.outputAria')}></textarea>
    <div class="encoding-result-actions">
      <Button id="base64-copy" icon="lucide:copy" disabled>{t('workspace.copyResult')}</Button>
      <Button id="base64-download" icon="lucide:download" disabled>{t('workspace.downloadResult')}</Button>
    </div>
    <div class="encoding-stats">
      <div><span>{t('workspace.inputChars')}</span><strong id="base64-stat-input">—</strong></div>
      <div><span>{t('workspace.outputChars')}</span><strong id="base64-stat-output">—</strong></div>
      <div><span>{t('workspace.bytes')}</span><strong id="base64-stat-bytes">—</strong></div>
      <div><span>{t('workspace.format')}</span><strong id="base64-stat-format">—</strong></div>
    </div>
  </Card>
</section>

<script>
  import '../../scripts/base64'
</script>
