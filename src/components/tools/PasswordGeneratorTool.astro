---
import { Icon } from 'astro-icon/components'
import CheckboxField from '../ui/CheckboxField.astro'
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'
import { createTranslator } from '../../i18n'

const t = createTranslator(Astro.locals.locale)
---

<section class="tool-workspace security-workspace" aria-live="polite">
  <div class="workspace-header">
    <div>
      <div class="breadcrumb"><span>{t('categories.security')}</span><b>/</b><strong>密码生成器</strong></div>
      <div class="title-line">
        <span class="title-icon"><Icon name="lucide:key-round" size={25} /></span>
        <div><h1>密码生成器</h1><p>使用浏览器安全随机数生成密码</p></div>
      </div>
    </div>
    <span class="privacy-badge"><Icon name="lucide:shield-check" size={16} />{t('common.localOnly')}</span>
  </div>

  <div class="security-notice"><Icon name="lucide:info" size={16} />密码不会离开当前设备；请使用密码管理器保存生成结果。</div>

  <Card class="tool-card">
    <div class="security-field">
      <div class="field-heading"><label for="password-length">密码长度</label><output id="password-length-value" for="password-length">20 位</output></div>
      <div class="password-length-control"><input id="password-length" type="range" min="8" max="64" value="20" /><input id="password-length-number" class="security-number-input" type="number" min="8" max="64" value="20" aria-label="密码长度数值" /></div>
    </div>
    <div class="security-field password-options-field">
      <span class="security-label">字符类型</span>
      <div class="security-option-grid">
        <CheckboxField id="password-lowercase" label="小写字母 a-z" checked />
        <CheckboxField id="password-uppercase" label="大写字母 A-Z" checked />
        <CheckboxField id="password-numbers" label="数字 0-9" checked />
        <CheckboxField id="password-symbols" label="符号 !@#$" checked />
      </div>
    </div>
    <div class="security-error" id="password-generator-error" role="alert" hidden></div>
    <div class="action-row">
      <Button id="password-generate" class="calculate-button" variant="primary" icon="lucide:refresh-cw">生成密码</Button>
      <Button id="password-clear" icon="lucide:trash-2">清空选项</Button>
    </div>
  </Card>

  <Card class="result-card security-result-card" ariaLabel="生成密码结果">
    <div class="result-heading"><div><span class="status-dot"></span><strong>生成结果</strong></div><span id="password-status">等待生成</span></div>
    <div class="password-output" id="password-output" data-empty="true"><code id="password-value">点击生成密码</code><button id="password-copy" type="button" aria-label="复制生成的密码" disabled><Icon name="lucide:copy" size={16} />复制</button></div>
    <div class="password-strength-summary"><div class="strength-heading"><strong id="password-strength-label">等待生成</strong><span id="password-strength-score">—</span></div><div class="strength-track"><i id="password-strength-bar"></i></div><small id="password-strength-detail">生成后显示强度估算</small></div>
  </Card>
</section>

<script>
  import '../../scripts/password-generator'
</script>
