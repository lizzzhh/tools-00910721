---
import { Icon } from 'astro-icon/components'
import CheckboxField from '../ui/CheckboxField.astro'
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'
import { createTranslator } from '../../i18n'

const t = createTranslator(Astro.locals.locale)
---

<section class="tool-workspace security-workspace" aria-live="polite">
  <div class="workspace-header">
    <div>
      <div class="breadcrumb"><span>{t('categories.security')}</span><b>/</b><strong>{t('tools.password-generator.name')}</strong></div>
      <div class="title-line">
        <span class="title-icon"><Icon name="lucide:key-round" size={25} /></span>
        <div><h1>{t('tools.password-generator.name')}</h1><p>{t('toolUi.password-generator.subtitle')}</p></div>
      </div>
    </div>
    <span class="privacy-badge"><Icon name="lucide:shield-check" size={16} />{t('common.localOnly')}</span>
  </div>

  <div class="security-notice"><Icon name="lucide:info" size={16} />{t('toolUi.password-generator.notice')}</div>

  <Card class="tool-card">
    <div class="security-field">
      <div class="field-heading"><label for="password-length">{t('toolUi.password-generator.lengthLabel')}</label><output id="password-length-value" for="password-length">20 {t('toolUi.password-generator.lengthUnit')}</output></div>
      <div class="password-length-control"><input id="password-length" type="range" min="8" max="64" value="20" /><input id="password-length-number" class="security-number-input" type="number" min="8" max="64" value="20" aria-label={t('toolUi.password-generator.lengthAria')} /></div>
    </div>
    <div class="security-field password-options-field">
      <span class="security-label">{t('toolUi.password-generator.classesLabel')}</span>
      <div class="security-option-grid">
        <CheckboxField id="password-lowercase" label={t('toolUi.password-generator.clsLower')} checked />
        <CheckboxField id="password-uppercase" label={t('toolUi.password-generator.clsUpper')} checked />
        <CheckboxField id="password-numbers" label={t('toolUi.password-generator.clsDigits')} checked />
        <CheckboxField id="password-symbols" label={t('toolUi.password-generator.clsSymbols')} checked />
      </div>
    </div>
    <div class="security-error" id="password-generator-error" role="alert" hidden></div>
    <div class="action-row">
      <Button id="password-generate" class="calculate-button" variant="primary" icon="lucide:refresh-cw">{t('toolUi.password-generator.generateButton')}</Button>
      <Button id="password-clear" icon="lucide:trash-2">{t('toolUi.password-generator.resetOptions')}</Button>
    </div>
  </Card>

  <Card class="result-card security-result-card" ariaLabel={t('toolUi.password-generator.resultTitle')}>
    <div class="result-heading"><div><span class="status-dot"></span><strong>{t('toolUi.password-generator.resultLabel')}</strong></div><span id="password-status">{t('toolUi.password-generator.idleStatus')}</span></div>
    <div class="password-output" id="password-output" data-empty="true"><code id="password-value">{t('toolUi.password-generator.idlePlaceholder')}</code><button id="password-copy" type="button" aria-label={t('toolUi.password-generator.copyAria')} disabled><Icon name="lucide:copy" size={16} />{t('common.copy')}</button></div>
    <div class="password-strength-summary"><div class="strength-heading"><strong id="password-strength-label">{t('toolUi.password-generator.idleStatus')}</strong><span id="password-strength-score">—</span></div><div class="strength-track"><i id="password-strength-bar"></i></div><small id="password-strength-detail">{t('toolUi.password-generator.idleHint')}</small></div>
  </Card>
</section>

<script>
  import '../../scripts/password-generator'
</script>
