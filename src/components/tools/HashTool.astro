---
import { Icon } from 'astro-icon/components'
import CheckboxField from '../ui/CheckboxField.astro'
import SelectField from '../ui/SelectField.astro'
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'
import { digestAlgorithms, hmacAlgorithms } from '../../lib/security/digests'
import { createTranslator } from '../../i18n'

const t = createTranslator(Astro.locals.locale)

const outputCaseOptions = [
  { value: 'lower', label: t('toolUi.hash.caseLower') },
  { value: 'upper', label: t('toolUi.hash.caseUpper') }
]
---

<section class="tool-workspace security-workspace" aria-live="polite">
  <div class="workspace-header">
    <div>
      <div class="breadcrumb"><span>{t('categories.security')}</span><b>/</b><strong>{t('tools.hash.name')}</strong></div>
      <div class="title-line">
        <span class="title-icon"><Icon name="lucide:hash" size={25} /></span>
        <div><h1>{t('tools.hash.name')}</h1><p>{t('toolUi.hash.subtitle')}</p></div>
      </div>
    </div>
    <span class="privacy-badge"><Icon name="lucide:shield-check" size={16} />{t('common.localOnly')}</span>
  </div>

  <div class="security-notice"><Icon name="lucide:info" size={16} />{t('toolUi.hash.notice')}</div>

  <Card class="tool-card">
    <div class="input-mode" role="tablist" aria-label={t('toolUi.hash.inputLabel')}>
      <button class="mode-button active" id="hash-text-tab" type="button" role="tab" aria-selected="true" aria-controls="hash-text-panel" data-mode="text"><Icon name="lucide:text" size={17} />{t('toolUi.hash.modeText')}</button>
      <button class="mode-button" id="hash-file-tab" type="button" role="tab" aria-selected="false" aria-controls="hash-file-panel" data-mode="file"><Icon name="lucide:file" size={17} />{t('toolUi.hash.modeFile')}</button>
    </div>

    <div class="algorithm-section">
      <span class="security-label">{t('toolUi.hash.algorithmsLabel')}</span>
      <div class="security-option-grid">
        {digestAlgorithms.map((algorithm) => <CheckboxField id={`hash-algo-${algorithm.id}`} name="hash-algorithms" value={algorithm.id} label={algorithm.label} checked={algorithm.id === 'md5' || algorithm.id === 'sha-256'} />)}
      </div>
    </div>

    <div class="algorithm-section">
      <span class="security-label">{t('toolUi.hash.hmacLabel')}<i class="security-label-note">{t('toolUi.hash.hmacNeedsKey')}</i></span>
      <div class="security-option-grid">
        {hmacAlgorithms.map((algorithm) => <CheckboxField id={`hash-algo-${algorithm.id}`} name="hash-algorithms" value={algorithm.id} label={algorithm.label} />)}
      </div>
    </div>

    <div class="security-field hash-key-field" id="hash-key-field" hidden>
      <div class="field-heading"><label for="hash-key">{t('toolUi.hash.keyLabel')}</label><div class="field-heading-actions"><CheckboxField id="hash-show-key" label={t('toolUi.hash.showKeyLabel')} /></div></div>
      <input class="security-input" id="hash-key" type="password" placeholder={t('toolUi.hash.keyPlaceholder')} spellcheck="false" autocomplete="new-password" />
    </div>

    <div class="mode-panel active" id="hash-text-panel" role="tabpanel" aria-labelledby="hash-text-tab" data-panel="text">
      <div class="field-heading">
        <label for="hash-input">{t('toolUi.hash.textLabel')}</label>
        <div class="field-heading-actions"><span><b id="hash-char-count">0</b> {t('common.charactersUnit')}</span><CheckboxField id="hash-realtime" label={t('toolUi.hash.textHint')} checked /></div>
      </div>
      <div class="textarea-wrap">
        <textarea id="hash-input" placeholder={t('toolUi.hash.textPlaceholder')} spellcheck="false" autocomplete="off" autofocus></textarea>
      </div>
    </div>

    <div class="mode-panel" id="hash-file-panel" role="tabpanel" aria-labelledby="hash-file-tab" data-panel="file" hidden>
      <input id="hash-file-input" type="file" hidden />
      <label class="drop-zone" id="hash-drop-zone" for="hash-file-input" tabindex="0">
        <span class="drop-icon"><Icon name="lucide:upload-cloud" size={27} /></span>
        <strong id="hash-drop-title">{t('toolUi.hash.dropLabel')}</strong>
        <small id="hash-drop-meta">{t('toolUi.hash.dropHint')}</small>
      </label>
      <div class="file-progress" id="hash-progress" hidden>
        <div class="file-progress-heading"><span id="hash-progress-label">{t('toolUi.hash.readyButton')}</span><b id="hash-progress-percent">0%</b></div>
        <div class="file-progress-track"><i id="hash-progress-bar"></i></div>
        <small id="hash-progress-detail">0 B / 0 B</small>
      </div>
    </div>

    <div class="action-row">
      <Button id="hash-calculate" class="calculate-button" variant="primary" icon="lucide:hash">{t('toolUi.hash.runButton')}</Button>
      <Button id="hash-cancel" hidden>{t('toolUi.hash.stopButton')}</Button>
      <Button id="hash-clear" icon="lucide:trash-2">{t('common.clear')}</Button>
    </div>
  </Card>

  <Card class="result-card security-result-card" ariaLabel={t('toolUi.hash.resultTitle')}>
    <div class="result-heading"><div><span class="status-dot"></span><strong>{t('toolUi.hash.resultLabel')}</strong></div><span id="hash-result-status">{t('workspace.waiting')}</span></div>
    <div class="hash-result-list" id="hash-results"></div>
    <div class="hash-result-actions">
      <Button id="hash-copy-all" icon="lucide:copy">{t('toolUi.hash.copyAll')}</Button>
      <SelectField id="hash-output-case" label={t('toolUi.hash.outputLabel')} value="lower" options={outputCaseOptions} />
    </div>
    <div class="result-meta"><span id="hash-algorithm-count">{t('toolUi.hash.idleStatus')}</span><span id="hash-detail">{t('toolUi.hash.idleHint')}</span></div>
  </Card>
</section>

<script>
  import '../../scripts/hash'
</script>