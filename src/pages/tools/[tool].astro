---
import { getTool, localizeTool, tools } from '../../data/tools'
import ToolPage from '../../components/ToolPage.astro'
import { createTranslator } from '../../i18n'
import { localePath } from '../../i18n/config'

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { tool: tool.id }, props: { toolId: tool.id } }))
}

const { toolId } = Astro.props
const locale = Astro.locals.locale
const t = createTranslator(locale)
const tool = localizeTool(getTool(toolId) ?? tools[0], t)
---

{getTool(toolId) ? <ToolPage tool={tool} /> : (
  <div class="not-found">
    <h1>{t('about.notFoundTitle')}</h1>
    <a href={localePath(locale, '/tools/')}>{t('about.backToTools')}</a>
  </div>
)}
