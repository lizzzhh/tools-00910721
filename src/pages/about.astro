---
import { Icon } from 'astro-icon/components'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="关于 · 透明质的工具箱" description="了解透明质的工具箱：一个纯前端、数据不离开浏览器的开发者工具箱。" activeNav="about">
  <section class="simple-page card-base">
    <span class="eyebrow">ABOUT TRANSPARENT TOOLBOX</span>
    <div class="simple-page-icon"><Icon name="lucide:info" size={30} /></div>
    <h1>关于透明质的工具箱</h1>
    <p>一个为程序员设计的轻量工具聚合站。所有计算均在浏览器本地完成，不上传、不存储你的输入内容。</p>
    <a class="primary-button" href="/tools/md5/">使用 MD5 工具<Icon name="lucide:arrow-right" size={18} /></a>
  </section>
</BaseLayout>
