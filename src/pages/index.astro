---
import BaseLayout from '../layouts/BaseLayout.astro'
import Dashboard from '../components/Dashboard.astro'
import { createTranslator } from '../i18n'
---

<BaseLayout title={`${createTranslator(Astro.locals.locale)('home.title')} · ${createTranslator(Astro.locals.locale)('meta.siteName')}`} description={createTranslator(Astro.locals.locale)('meta.description')} activeNav="home">
  <Dashboard />
</BaseLayout>
