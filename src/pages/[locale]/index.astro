---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Dashboard from '../../components/Dashboard.astro'
import { prefixedLocales } from '../../i18n/config'
import { createTranslator, type Locale } from '../../i18n'

export function getStaticPaths() {
  return prefixedLocales.map((locale) => ({ params: { locale } }))
}

const locale = Astro.locals.locale as Locale
const t = createTranslator(locale)
---

<BaseLayout title={`${t('home.title')} · ${t('meta.siteName')}`} description={t('meta.description')} activeNav="home">
  <Dashboard />
</BaseLayout>
