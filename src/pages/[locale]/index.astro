---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Dashboard from '../../components/Dashboard.astro'
import { localeMeta, prefixedLocales } from '../../i18n/config'
import { createTranslator, type Locale } from '../../i18n'

export function getStaticPaths() {
  // the route param is the URL prefix (e.g. zh-tw), not the locale id
  return prefixedLocales.map((locale) => ({ params: { locale: localeMeta[locale].prefix } }))
}

const locale = Astro.locals.locale as Locale
const t = createTranslator(locale)
---

<BaseLayout title={`${t('home.title')} · ${t('meta.siteName')}`} description={t('meta.description')} activeNav="home">
  <Dashboard />
</BaseLayout>
