---
import { getTool, localizeTool, tools } from '../../../data/tools'
import ToolPage from '../../../components/ToolPage.astro'
import { localeMeta, prefixedLocales } from '../../../i18n/config'
import { createTranslator } from '../../../i18n'
import { localePath } from '../../../i18n/config'

export function getStaticPaths() {
  // the route param is the URL prefix (e.g. zh-tw), not the locale id
  return prefixedLocales.flatMap((locale) =>
    tools.map((tool) => ({ params: { locale: localeMeta[locale].prefix, tool: tool.id } }))
  )
}

const toolId = Astro.params.tool ?? ''
const locale = Astro.locals.locale
const t = createTranslator(locale)
const found = getTool(toolId)
---

{found ? <ToolPage tool={localizeTool(found, t)} /> : (
  <div class="not-found">
    <h1>{t('about.notFoundTitle')}</h1>
    <a href={localePath(locale, '/tools/')}>{t('about.backToTools')}</a>
  </div>
)}
