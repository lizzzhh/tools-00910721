---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ToolCatalog from '../../../components/ToolCatalog.astro'
import { prefixedLocales } from '../../../i18n/config'
import { createTranslator } from '../../../i18n'

export function getStaticPaths() {
  return prefixedLocales.map((locale) => ({ params: { locale } }))
}

const t = createTranslator(Astro.locals.locale)
---

<BaseLayout title={`${t('catalog.title')} · ${t('meta.siteName')}`} description={t('catalog.subtitle')} activeNav="tools">
  <ToolCatalog />
</BaseLayout>
