---
import BaseLayout from '../layouts/BaseLayout.astro'
import ToolCatalog from '../components/ToolCatalog.astro'
import { createTranslator } from '../i18n'

const t = createTranslator(Astro.locals.locale)
---

<BaseLayout title={`${t('catalog.favoritesTitle')} · ${t('meta.siteName')}`} description={t('catalog.favoritesSubtitle')} activeNav="favorites">
  <ToolCatalog favoritesOnly />
</BaseLayout>
